{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-amcol-way",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-amcol-way-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PRESENCE_ROOMS", "class_name": "PresenceRoom" }
    ]
  },
  "migrations": [
    { "tag": "presence-v1", "new_sqlite_classes": ["PresenceRoom"] }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "STAFF_EMAILS": ""
  },
  "observability": {
    "enabled": false
  }
}
